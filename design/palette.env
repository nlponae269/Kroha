# Палитра Kroha OS. Все темы (GTK, Openbox, tint2, rofi, dunst, GRUB,
# Plymouth, LightDM, Calamares, обои) генерируются из этих значений.
BG="#1E1F26"
PANEL="#272833"
SURFACE="#2F3140"
SURFACE_HI="#3A3D50"
BORDER="#3D4052"
TEXT="#E8E6E3"
TEXT_DIM="#9A9BA8"
ACCENT="#FF8A3D"
ACCENT_DARK="#D9692A"
ACCENT_LIGHT="#FFB27D"
ACCENT2="#4FC1B0"
ACCENT3="#8B6CF6"
ACCENT4="#FF5E7E"
ERROR="#E5534B"
SUCCESS="#57AB5A"
WARNING="#E3B341"
# Непрозрачность панелей и дока в процентах (размытие делает picom)
GLASS_OPACITY="42"
FONT_UI="Inter"
FONT_UI_SIZE="10"
FONT_MONO="JetBrains Mono"
FONT_MONO_SIZE="10"
RADIUS="8"
DOCK_RADIUS="18"
