<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>Kroha OS — макет рабочего стола</title>
<!--
  Макет главного экрана Kroha OS 1366×768 (экран HP 15-bw0xx).
  Это эскиз того, что собирается в ISO: верхняя строка = tint2 (top),
  док = tint2 (dock), лаунчер = rofi, размытие = picom (dual_kawase).
  Состояние «лаунчер открыт»: desktop.html#launcher
-->
<style>
:root{
  --bg:@BG@; --panel:@PANEL@; --surface:@SURFACE@; --surface-hi:@SURFACE_HI@;
  --border:@BORDER@; --text:@TEXT@; --dim:@TEXT_DIM@;
  --accent:@ACCENT@; --accent2:@ACCENT2@; --accent3:@ACCENT3@; --accent4:@ACCENT4@;
  --glass: rgba(@BG_RGB@, 0.42);
  --glass-strong: rgba(@BG_RGB@, 0.55);
  --r: @RADIUS@px; --dock-r: @DOCK_RADIUS@px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:1366px;height:768px;overflow:hidden;background:var(--bg)}
body{font-family:"@FONT_UI@",sans-serif;font-size:13px;color:var(--text);
  background:url(wallpaper.png) center/cover no-repeat;position:relative;
  -webkit-font-smoothing:antialiased}

/* ---------- верхняя строка (tint2 top, 30 px) ---------- */
.topbar{position:absolute;left:0;right:0;top:0;height:30px;display:flex;align-items:center;
  padding:0 10px;background:var(--glass);backdrop-filter:blur(26px) saturate(150%);
  border-bottom:1px solid rgba(255,255,255,.06);z-index:20}
.brand{display:flex;align-items:center;gap:8px;padding:3px 10px 3px 4px;border-radius:999px;
  font-weight:700;letter-spacing:.2px}
.brand img{width:20px;height:20px}
.brand:hover{background:rgba(255,255,255,.08)}
.spacer{flex:1}
.clock{position:absolute;left:50%;transform:translateX(-50%);font-weight:600;font-variant-numeric:tabular-nums}
.clock span{color:var(--dim);font-weight:500;margin-right:8px}
.tray{display:flex;align-items:center;gap:12px}
.tray img{width:18px;height:18px;display:block}
.kbd{font-size:11px;font-weight:700;padding:1px 6px;border-radius:5px;background:rgba(255,255,255,.12)}
.bat{display:flex;align-items:center;gap:4px;font-size:12px;color:var(--dim)}
.power{width:24px;height:24px;border-radius:999px;display:grid;place-items:center;background:rgba(@ACCENT_RGB@,.18)}

/* ---------- значки на рабочем столе (pcmanfm --desktop) ---------- */
.desk{position:absolute;left:22px;top:52px;display:flex;flex-direction:column;gap:14px;z-index:1}
.di{width:92px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;
  font-size:12px;line-height:1.25;text-shadow:0 1px 3px rgba(0,0,0,.7)}
.di img{width:52px;height:52px;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))}

/* ---------- приветствие (dunst) ---------- */
.toast{position:absolute;right:14px;top:42px;width:330px;padding:14px 16px;border-radius:14px;
  background:var(--glass-strong);backdrop-filter:blur(30px) saturate(160%);
  border:1px solid rgba(255,255,255,.08);display:flex;gap:12px;z-index:15}
.toast img{width:40px;height:40px}
.toast b{display:block;margin-bottom:3px}
.toast p{color:var(--dim);font-size:12px;line-height:1.4}

/* ---------- окно-пример (Openbox, скруглено picom) ---------- */
.win{position:absolute;left:300px;top:92px;width:640px;height:420px;border-radius:12px;overflow:hidden;
  background:var(--panel);box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.06);z-index:5}
.title{height:34px;display:flex;align-items:center;padding:0 12px;background:var(--bg);gap:10px}
.dots{display:flex;gap:8px}
.dots i{width:13px;height:13px;border-radius:50%;display:block}
.dots i:nth-child(1){background:var(--accent4)} .dots i:nth-child(2){background:var(--accent)} .dots i:nth-child(3){background:var(--accent2)}
.title .t{flex:1;text-align:center;font-weight:600;color:var(--dim);margin-right:60px}
.fm{display:flex;height:calc(100% - 34px)}
.side{width:170px;padding:12px 8px;background:var(--panel);display:flex;flex-direction:column;gap:2px}
.side div{padding:7px 10px;border-radius:var(--r);color:var(--dim);display:flex;gap:9px;align-items:center}
.side div img{width:18px;height:18px}
.side .on{background:rgba(@ACCENT_RGB@,.16);color:var(--text)}
.main{flex:1;background:var(--surface);padding:14px;display:grid;grid-template-columns:repeat(5,1fr);gap:8px;align-content:start}
.f{display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px 4px;border-radius:var(--r);font-size:12px}
.f img{width:48px;height:48px}
.f.sel{background:rgba(@ACCENT_RGB@,.22);outline:1px solid rgba(@ACCENT_RGB@,.6)}

/* ---------- док (tint2 dock): парящий, сильное размытие ---------- */
.dock{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;align-items:center;gap:6px;
  padding:8px 10px;border-radius:var(--dock-r);background:var(--glass);
  backdrop-filter:blur(34px) saturate(170%);border:1px solid rgba(255,255,255,.10);
  box-shadow:0 12px 40px rgba(0,0,0,.35);z-index:30}
.app{position:relative;width:52px;height:52px;border-radius:14px;display:grid;place-items:center}
.app img{width:42px;height:42px}
.app.run::after{content:"";position:absolute;bottom:-3px;left:18px;right:18px;height:3px;border-radius:3px;background:var(--accent)}
.app.act{background:rgba(255,255,255,.12)}
.sep{width:1px;height:34px;background:rgba(255,255,255,.14);margin:0 4px}
.tip{position:absolute;bottom:64px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:12px;
  padding:4px 10px;border-radius:7px;background:var(--glass-strong);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.08)}

/* ---------- лаунчер (rofi, полноэкранный, размытие фона) ---------- */
.launcher{display:none;position:absolute;inset:0;z-index:25;padding:70px 150px 0;
  background:rgba(@BG_RGB@,.50);backdrop-filter:blur(40px) saturate(140%)}
body.l .launcher{display:block}
body.l .toast,body.l .tip{display:none}
.search{margin:0 auto;width:520px;height:44px;border-radius:999px;display:flex;align-items:center;gap:12px;padding:0 18px;
  background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);font-size:15px}
.search .ph{color:var(--dim)} .search .cur{width:2px;height:20px;background:var(--accent);margin-left:-8px}
.tabs{display:flex;justify-content:center;gap:8px;margin:16px 0 22px}
.tabs div{padding:6px 16px;border-radius:999px;color:var(--dim);font-weight:600;font-size:12.5px}
.tabs .on{background:var(--accent);color:var(--bg)}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px 10px}
.g{display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 4px 10px;border-radius:16px;font-size:12.5px;text-align:center}
.g img{width:56px;height:56px;filter:drop-shadow(0 6px 12px rgba(0,0,0,.3))}
.g.sel{background:rgba(255,255,255,.12);box-shadow:inset 0 0 0 1.5px rgba(@ACCENT_RGB@,.9)}
.hint{position:absolute;left:0;right:0;bottom:94px;text-align:center;color:var(--dim);font-size:12px}
.hint b{color:var(--text);font-weight:600;padding:1px 6px;border-radius:5px;background:rgba(255,255,255,.1);margin:0 2px}
</style>
</head>
<body>

<div class="topbar">
  <div class="brand"><img src="logo.svg" alt="">@OS_NAME@</div>
  <div class="clock"><span>вт, 10 нояб.</span>18:42</div>
  <div class="spacer"></div>
  <div class="tray">
    <span class="kbd">RU</span>
    <img src="icons/panel/network-wireless-signal-good.svg" alt="">
    <img src="icons/panel/audio-volume-high.svg" alt="">
    <span class="bat"><img src="icons/panel/battery-080.svg" alt="">80%</span>
    <span class="power"><img src="icons/panel/system-shutdown-panel.svg" alt="" style="width:14px;height:14px"></span>
  </div>
</div>

<div class="desk">
  <div class="di"><img src="logo.svg" alt="">Установить @OS_NAME@</div>
  <div class="di"><img src="icons/places/user-home.svg" alt="">Домашняя папка</div>
  <div class="di"><img src="icons/places/user-trash.svg" alt="">Корзина</div>
</div>

<div class="toast">
  <img src="logo.svg" alt="">
  <div><b>Добро пожаловать в @OS_NAME@</b>
  <p>Нажми <b style="display:inline">Win</b>, чтобы открыть программы. Установить систему — значок на рабочем столе.</p></div>
</div>

<div class="win">
  <div class="title"><div class="dots"><i></i><i></i><i></i></div><div class="t">Домашняя папка — Файлы</div></div>
  <div class="fm">
    <div class="side">
      <div class="on"><img src="icons/places/user-home.svg" alt="">Домашняя</div>
      <div><img src="icons/places/user-desktop.svg" alt="">Рабочий стол</div>
      <div><img src="icons/places/folder-download.svg" alt="">Загрузки</div>
      <div><img src="icons/places/folder-documents.svg" alt="">Документы</div>
      <div><img src="icons/places/folder-pictures.svg" alt="">Изображения</div>
      <div><img src="icons/places/folder-music.svg" alt="">Музыка</div>
      <div><img src="icons/places/folder-videos.svg" alt="">Видео</div>
      <div><img src="icons/places/user-trash.svg" alt="">Корзина</div>
    </div>
    <div class="main">
      <div class="f"><img src="icons/places/user-desktop.svg" alt="">Рабочий стол</div>
      <div class="f sel"><img src="icons/places/folder-download.svg" alt="">Загрузки</div>
      <div class="f"><img src="icons/places/folder-documents.svg" alt="">Документы</div>
      <div class="f"><img src="icons/places/folder-pictures.svg" alt="">Изображения</div>
      <div class="f"><img src="icons/places/folder-music.svg" alt="">Музыка</div>
      <div class="f"><img src="icons/places/folder-videos.svg" alt="">Видео</div>
      <div class="f"><img src="icons/places/folder-templates.svg" alt="">Шаблоны</div>
      <div class="f"><img src="icons/places/folder-publicshare.svg" alt="">Общедоступные</div>
    </div>
  </div>
</div>

<div class="launcher">
  <div class="search"><img src="icons/panel/search.svg" alt="" style="width:18px;height:18px;opacity:.7"><span class="cur"></span><span class="ph">Поиск программ…</span></div>
  <div class="tabs"><div class="on">Программы</div><div>Открытые окна</div><div>Выполнить</div></div>
  <div class="grid">
    <div class="g sel"><img src="icons/apps/firefox-esr.svg" alt="">Firefox</div>
    <div class="g"><img src="icons/apps/system-file-manager.svg" alt="">Файлы</div>
    <div class="g"><img src="icons/apps/utilities-terminal.svg" alt="">Терминал</div>
    <div class="g"><img src="icons/apps/accessories-text-editor.svg" alt="">Блокнот</div>
    <div class="g"><img src="icons/apps/mpv.svg" alt="">Видео</div>
    <div class="g"><img src="icons/apps/image-viewer.svg" alt="">Фото</div>
    <div class="g"><img src="icons/apps/qpdfview.svg" alt="">PDF</div>
    <div class="g"><img src="icons/apps/accessories-calculator.svg" alt="">Калькулятор</div>
    <div class="g"><img src="icons/apps/xarchiver.svg" alt="">Архивы</div>
    <div class="g"><img src="icons/apps/org.xfce.screenshooter.svg" alt="">Снимок экрана</div>
    <div class="g"><img src="icons/apps/synaptic.svg" alt="">Программы</div>
    <div class="g"><img src="icons/apps/multimedia-volume-control.svg" alt="">Звук</div>
    <div class="g"><img src="icons/apps/blueman.svg" alt="">Bluetooth</div>
    <div class="g"><img src="icons/apps/utilities-system-monitor.svg" alt="">Диспетчер задач</div>
  </div>
  <div class="hint"><b>Enter</b> запустить · <b>Tab</b> следующая вкладка · <b>Esc</b> закрыть</div>
</div>

<div class="dock">
  <div class="app act"><img src="logo.svg" alt=""></div>
  <div class="sep"></div>
  <div class="app run"><img src="icons/apps/firefox-esr.svg" alt=""></div>
  <div class="app run"><img src="icons/apps/system-file-manager.svg" alt=""><div class="tip">Файлы</div></div>
  <div class="app"><img src="icons/apps/utilities-terminal.svg" alt=""></div>
  <div class="app"><img src="icons/apps/accessories-text-editor.svg" alt=""></div>
  <div class="app"><img src="icons/apps/mpv.svg" alt=""></div>
  <div class="app"><img src="icons/apps/synaptic.svg" alt=""></div>
  <div class="sep"></div>
  <div class="app"><img src="icons/places/user-trash.svg" alt=""></div>
</div>

<script>
  if (location.hash === "#launcher") document.body.classList.add("l");
  addEventListener("hashchange", () => document.body.classList.toggle("l", location.hash === "#launcher"));
</script>
</body>
</html>
