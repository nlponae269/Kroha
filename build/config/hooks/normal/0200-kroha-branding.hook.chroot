#!/bin/sh
# Имя системы: /etc/os-release (через dpkg-divert, чтобы обновления base-files не затирали),
# /etc/issue, заставка Plymouth.
set -e
. /usr/share/kroha/os-release
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cp /usr/share/kroha/os-release /usr/lib/os-release
ln -sf ../usr/lib/os-release /etc/os-release
for f in /etc/issue /etc/issue.net; do
	dpkg-divert --quiet --local --rename --add "$f"
done
printf '%s \\n \\l\n\n' "$PRETTY_NAME" > /etc/issue
printf '%s\n' "$PRETTY_NAME" > /etc/issue.net

plymouth-set-default-theme kroha
# lsb_release и fastfetch берут имя из os-release; neofetch не ставим
