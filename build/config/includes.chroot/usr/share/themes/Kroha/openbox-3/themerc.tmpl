# Openbox-тема Kroha. Цвета берутся из design/palette.env
border.width: 0
padding.width: 10
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.border.width: 1
menu.border.color: @BORDER@
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.separator.color: @BORDER@
osd.border.width: 1
osd.border.color: @BORDER@

window.active.border.color: @BG@
window.inactive.border.color: @BG@
window.active.title.separator.color: @BG@
window.inactive.title.separator.color: @BG@
window.active.client.color: @PANEL@
window.inactive.client.color: @PANEL@

window.active.title.bg: flat solid
window.active.title.bg.color: @BG@
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: @BG@
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: @TEXT@
window.inactive.label.text.color: @TEXT_DIM@
window.label.text.justify: center
window.active.handle.bg: flat solid
window.active.handle.bg.color: @BG@
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: @BG@
window.active.grip.bg: flat solid
window.active.grip.bg.color: @BG@
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: @BG@

# Кнопки — цветные точки (закрыть / свернуть / развернуть)
window.active.button.unpressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.active.button.toggled.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.toggled.bg: parentrelative
window.active.button.unpressed.image.color: @TEXT_DIM@
window.active.button.close.unpressed.image.color: @ACCENT4@
window.active.button.close.hover.image.color: @ERROR@
window.active.button.close.pressed.image.color: @ERROR@
window.active.button.iconify.unpressed.image.color: @ACCENT@
window.active.button.iconify.hover.image.color: @ACCENT_LIGHT@
window.active.button.iconify.pressed.image.color: @ACCENT_DARK@
window.active.button.max.unpressed.image.color: @ACCENT2@
window.active.button.max.hover.image.color: @ACCENT2@
window.active.button.max.pressed.image.color: @ACCENT2@
window.active.button.max.toggled.unpressed.image.color: @ACCENT2@
window.active.button.max.toggled.hover.image.color: @ACCENT2@
window.active.button.max.toggled.pressed.image.color: @ACCENT2@
window.active.button.hover.image.color: @TEXT@
window.active.button.pressed.image.color: @TEXT@
window.active.button.disabled.image.color: @SURFACE_HI@
window.inactive.button.unpressed.image.color: @SURFACE_HI@
window.inactive.button.hover.image.color: @TEXT_DIM@
window.inactive.button.pressed.image.color: @TEXT_DIM@
window.inactive.button.disabled.image.color: @SURFACE_HI@

menu.items.bg: flat solid
menu.items.bg.color: @PANEL@
menu.items.text.color: @TEXT@
menu.items.disabled.text.color: @TEXT_DIM@
menu.items.active.bg: flat solid
menu.items.active.bg.color: @ACCENT@
menu.items.active.text.color: @BG@
menu.title.bg: flat solid
menu.title.bg.color: @BG@
menu.title.text.color: @ACCENT@
menu.title.text.justify: center
menu.bullet.image.color: @TEXT_DIM@
menu.bullet.selected.image.color: @BG@

osd.bg: flat solid
osd.bg.color: @PANEL@
osd.label.bg: flat solid
osd.label.bg.color: @PANEL@
osd.label.text.color: @TEXT@
osd.hilight.bg: flat solid
osd.hilight.bg.color: @ACCENT@
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: @SURFACE_HI@
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: @SURFACE@
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: @ACCENT@
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: @ACCENT_DARK@
