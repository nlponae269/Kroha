/* Лаунчер Kroha OS: полноэкранная сетка поверх размытого рабочего стола.
   Важно: одно свойство — одна строка (у rofi строки в кавычках «жадные»). */
* {
    bg:        rgba(@BG_RGB@, 0.50);
    fg:        @TEXT@;
    dim:       @TEXT_DIM@;
    accent:    @ACCENT@;
    chip:      rgba(255, 255, 255, 0.10);
    chipline:  rgba(255, 255, 255, 0.14);
    sel:       rgba(255, 255, 255, 0.12);
    background-color: transparent;
    text-color: @fg;
    font: "@FONT_UI@ 10";
}
window {
    fullscreen: true;
    background-color: @bg;
    padding: 64px 12% 24px;
}
mainbox {
    children: [ inputbar, mode-switcher, listview ];
    spacing: 0;
}
inputbar {
    children: [ textbox-icon, entry ];
    margin: 0 22%;
    padding: 11px 18px;
    spacing: 12px;
    border: 1px;
    border-radius: 999px;
    border-color: @chipline;
    background-color: @chip;
}
textbox-icon {
    expand: false;
    str: "⌕";
    font: "@FONT_UI@ 16";
    text-color: @dim;
    vertical-align: 0.5;
}
entry {
    placeholder: "Поиск программ…";
    placeholder-color: @dim;
    cursor-color: @accent;
    font: "@FONT_UI@ 11";
    vertical-align: 0.5;
}
mode-switcher {
    margin: 16px 26% 20px;
    spacing: 8px;
}
button {
    padding: 6px 4px;
    border-radius: 999px;
    text-color: @dim;
    horizontal-align: 0.5;
    font: "@FONT_UI@ SemiBold 9";
}
button selected {
    background-color: @accent;
    text-color: @BG@;
}
listview {
    columns: 7;
    lines: 4;
    flow: horizontal;
    spacing: 6px 10px;
    cycle: false;
    dynamic: false;
    fixed-columns: true;
    fixed-height: true;
    scrollbar: false;
}
element {
    children: [ element-icon, element-text ];
    orientation: vertical;
    padding: 12px 4px 10px;
    spacing: 8px;
    border-radius: 16px;
}
element selected.normal, element selected.active {
    background-color: @sel;
    border: 2px;
    border-color: @accent;
}
element-icon {
    size: 52px;
    horizontal-align: 0.5;
}
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
message {
    margin: 0 22% 10px;
}
textbox {
    horizontal-align: 0.5;
    text-color: @dim;
}
