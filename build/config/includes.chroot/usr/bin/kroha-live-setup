#!/bin/sh
# Только в live-режиме: значок «Установить …» на рабочем столе и приветствие.
. /etc/os-release
# Live-режим: экран не гаснет (иначе во время установки он чернеет и пугает)
xset s off -dpms 2>/dev/null
(sleep 15; xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -n -t bool -s false;
 xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/blank-on-ac -n -t int -s 0;
 xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/blank-on-battery -n -t int -s 0) >/dev/null 2>&1 &
desk="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
mkdir -p "$desk"
cp /usr/share/applications/kroha-install.desktop "$desk/kroha-install.desktop"
chmod +x "$desk/kroha-install.desktop"
sleep 4
notify-send -a "$NAME" -i kroha-logo "Добро пожаловать в $NAME" \
	"Нажми Win, чтобы открыть программы.\nУстановить систему — значок «Установить $NAME» на рабочем столе."
