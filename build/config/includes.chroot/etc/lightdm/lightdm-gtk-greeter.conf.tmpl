[greeter]
background=/usr/share/backgrounds/kroha/login.png
user-background=false
theme-name=Kroha
icon-theme-name=Kroha
cursor-theme-name=Adwaita
font-name=@FONT_UI@ 11
xft-antialias=true
xft-hintstyle=hintslight
xft-rgba=rgb
default-user-image=/usr/share/pixmaps/kroha-logo.png
indicators=~host;~spacer;~clock;~spacer;~layout;~session;~a11y;~power
clock-format=%A, %e %B  %H:%M
position=50%,center 52%,center
round-user-image=true
panel-position=top
hide-user-image=false
