[general]
fontname=@FONT_MONO@ @FONT_MONO_SIZE@
selchars=-A-Za-z0-9,./?%&#:_
scrollback=2000
bgcolor=@BG@
fgcolor=@TEXT@
palette_color_0=#2F3140
palette_color_1=@ERROR@
palette_color_2=@SUCCESS@
palette_color_3=@WARNING@
palette_color_4=#6CA4F8
palette_color_5=@ACCENT3@
palette_color_6=@ACCENT2@
palette_color_7=@TEXT@
palette_color_8=@TEXT_DIM@
palette_color_9=#FF7B72
palette_color_10=#7EE787
palette_color_11=#F2CC60
palette_color_12=#A5C8FF
palette_color_13=#C3AAFF
palette_color_14=#7FE0D2
palette_color_15=#FFFFFF
color_preset=Custom
disallowbold=false
boldbright=false
cursorblinks=true
cursorunderline=false
audiblebell=false
visualbell=false
tabpos=top
geometry_columns=96
geometry_rows=26
hidescrollbar=true
hidemenubar=true
hideclosebutton=false
hidepointer=false
disablef10=true
disablealt=false
disableconfirm=true

[shortcut]
new_window_accel=<Primary><Shift>n
new_tab_accel=<Primary><Shift>t
close_tab_accel=<Primary><Shift>w
close_window_accel=<Primary><Shift>q
copy_accel=<Primary><Shift>c
paste_accel=<Primary><Shift>v
zoom_in_accel=<Primary>plus
zoom_out_accel=<Primary>minus
zoom_reset_accel=<Primary>0
