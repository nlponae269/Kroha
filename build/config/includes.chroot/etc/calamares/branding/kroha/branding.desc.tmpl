---
componentName: kroha
welcomeStyleCalamares: false
welcomeExpandingLogo: false
# Экран ноутбука 1366×768 — окно обязано помещаться между строкой и доком
windowExpanding: noexpand
windowSize: 980px,600px
windowPlacement: center
sidebar: widget
navigation: widget
strings:
    productName:         "@OS_NAME@"
    shortProductName:    "@OS_NAME@"
    version:             "@OS_VERSION@"
    shortVersion:        "@OS_VERSION@"
    versionedName:       "@OS_NAME@ @OS_VERSION@"
    shortVersionedName:  "@OS_NAME@ @OS_VERSION@"
    bootloaderEntryName: "@OS_NAME@"
    productUrl:          "@OS_HOME_URL@"
    supportUrl:          "@OS_SUPPORT_URL@"
    knownIssuesUrl:      "@OS_BUG_URL@"
    releaseNotesUrl:     "@OS_HOME_URL@"
    donateUrl:           "@OS_HOME_URL@"
images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"
slideshow:               "show.qml"
slideshowAPI: 2
style:
   SidebarBackground:        "@BG@"
   SidebarText:              "@TEXT@"
   SidebarTextCurrent:       "@BG@"
   SidebarBackgroundCurrent: "@ACCENT@"
