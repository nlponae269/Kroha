#!/bin/sh
# Параметры live-build. Переменные (OS_NAME, LIVE_USER, ...) экспортирует
# scripts/build-iso.sh из config/os-release.env.
set -e

lb config noauto \
	--mode debian \
	--system live \
	--distribution "${DEBIAN_SUITE:-trixie}" \
	--architectures amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--mirror-bootstrap "${KROHA_MIRROR:-http://deb.debian.org/debian/}" \
	--mirror-chroot "${KROHA_MIRROR:-http://deb.debian.org/debian/}" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--mirror-binary-security "http://security.debian.org/debian-security/" \
	--security true \
	--updates true \
	--apt-recommends false \
	--apt-indices false \
	--cache-packages true \
	--linux-flavours amd64 \
	--firmware-chroot false \
	--firmware-binary false \
	--initramfs live-boot \
	--binary-images iso-hybrid \
	--bootloaders "grub-pc grub-efi" \
	--uefi-secure-boot enable \
	--debian-installer none \
	--memtest none \
	--checksums sha256 \
	--zsync false \
	--win32-loader false \
	--chroot-squashfs-compression-type xz \
	--iso-volume "${ISO_VOLUME:-KROHA_OS}" \
	--iso-application "${OS_NAME:-Kroha OS}" \
	--iso-publisher "${OS_NAME:-Kroha OS}; ${OS_HOME_URL:-}" \
	--iso-preparer "live-build" \
	--bootappend-live "boot=live components quiet splash loglevel=3 username=${LIVE_USER:-kroha} hostname=${LIVE_HOSTNAME:-kroha} locales=ru_RU.UTF-8 keyboard-layouts=us,ru keyboard-options=grp:alt_shift_toggle timezone=${DEFAULT_TIMEZONE:-Europe/Moscow}" \
	--bootappend-live-failsafe "boot=live components nomodeset username=${LIVE_USER:-kroha} hostname=${LIVE_HOSTNAME:-kroha} locales=ru_RU.UTF-8 keyboard-layouts=us,ru keyboard-options=grp:alt_shift_toggle timezone=${DEFAULT_TIMEZONE:-Europe/Moscow} kroha.noeffects" \
	"${@}"
